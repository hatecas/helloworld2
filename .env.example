# 이 파일을 .env.local 로 복사해서 쓰세요. (아무것도 설정하지 않아도 앱은 그냥 돌아갑니다)

# ── 세션 ────────────────────────────────────────────────────────────────
# 로그인 쿠키(JWT)에 서명할 키. 배포 전 반드시 바꾸세요.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Supabase ────────────────────────────────────────────────────────────
# 아래 두 값을 모두 채우면 인메모리 시드 대신 Supabase 를 씁니다.
# 채우기 전에 supabase/schema.sql → supabase/seed.sql 순서로 실행하세요.
#
# service_role 키는 RLS 를 무시하는 마스터 키입니다. 서버에서만 쓰이며
# 브라우저로 절대 나가면 안 됩니다. (NEXT_PUBLIC_ 접두사 붙이지 마세요)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 광장(/plaza)의 실시간 접속용. 브라우저가 Supabase Realtime 에 직접 붙는 데 씁니다.
# 대시보드 > Settings > API 의 'anon public' 키. 공개돼도 되는 키입니다.
# 비워 두면 광장은 열리되 혼자만 걸어다니게 됩니다(다른 사람이 안 보임).
SUPABASE_ANON_KEY=

# ── 카카오맵 ────────────────────────────────────────────────────────────
# '찾아오는 길' 페이지에서 쓰는 JavaScript 키.
# 비워 두면 구 프로젝트에 하드코딩돼 있던 키를 그대로 씁니다.
NEXT_PUBLIC_KAKAO_MAP_KEY=
